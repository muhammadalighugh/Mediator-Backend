# Copy this file to .env and fill in your own keys — never commit .env to Git.

# AssemblyAI (realtime transcription + batch diarization)
# Get a key at https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# LLM — reasoning layer
# Set LLM_PROVIDER to either "anthropic" or "openai"
LLM_PROVIDER=openai
# Your OpenAI or Anthropic API key
LLM_API_KEY=your_llm_api_key_here
# Leave blank to use the provider default (claude-3-5-haiku / gpt-4o-mini)
LLM_MODEL=

# Audio
SAMPLE_RATE=16000

# Notes:
#  - sentence-transformers model (all-MiniLM-L6-v2) downloads on first run (~90MB)
#  - Chroma collections are persisted at sessions/{id}/chroma/
#  - Audio WAV files are saved at sessions/{id}/audio.wav
